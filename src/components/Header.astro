---
const navItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Tentang', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-gray-200 bg-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl font-extrabold tracking-tight text-gray-900">Hidayat</span>
        <span class="hidden sm:inline text-xs font-medium text-gray-400 border-l border-gray-200 pl-2 ml-1">Blog & Portfolio</span>
      </a>

      <nav class="hidden sm:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors ${
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-blue-600'
                : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <button
        id="mobile-menu-btn"
        class="sm:hidden p-2 -mr-2 text-gray-600 hover:text-gray-900"
        aria-label="Toggle menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden sm:hidden border-t border-gray-100 bg-white">
    <nav class="max-w-6xl mx-auto px-6 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-3 py-2 text-sm font-medium rounded-md transition-colors ${
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? 'text-blue-600 bg-blue-50'
              : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>