---
interface Props {
  title: string;
  slug: string;
  excerpt: string;
  coverImage?: string;
  publishDate: string;
  category?: string;
  featured?: boolean;
}

const { title, slug, excerpt, coverImage, publishDate, category, featured = false } = Astro.props;
const formattedDate = new Date(publishDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class={`group ${featured ? 'sm:flex sm:gap-8' : ''}`}>
  <a href={`/blog/${slug}`} class="block">
    {coverImage && (
      <div class={`overflow-hidden rounded-lg bg-gray-100 ${featured ? 'sm:w-1/2 aspect-video sm:aspect-[4/3]' : 'aspect-video'} mb-4`}>
        <img
          src={coverImage}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
    <div class={`space-y-2 ${featured ? 'sm:w-1/2 sm:flex sm:flex-col sm:justify-center' : ''}`}>
      {category && (
        <span class="inline-block text-xs font-semibold text-blue-600 uppercase tracking-wider">
          {category}
        </span>
      )}
      <h3 class={`font-bold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug ${
        featured ? 'text-xl sm:text-2xl' : 'text-lg'
      }`}>
        {title}
      </h3>
      <p class={`text-gray-500 leading-relaxed ${featured ? 'line-clamp-3' : 'text-sm line-clamp-2'}`}>
        {excerpt}
      </p>
      <time class="block text-xs text-gray-400 font-medium" datetime={publishDate}>
        {formattedDate}
      </time>
    </div>
  </a>
</article>