---
interface Props {
  title: string;
  slug: string;
  excerpt: string;
  coverImage?: string;
  publishDate: string;
  category?: string;
  layout?: 'grid' | 'list' | 'hero' | 'compact' | 'subhero';
  isFirstCard?: boolean;
}

const { title, slug, excerpt, coverImage, publishDate, category, layout = 'grid', isFirstCard = false } = Astro.props;

// Convert to ID format, e.g. "22 Juli 2026"
const dateObj = new Date(publishDate);
const formattedDate = dateObj.toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class={`group block ${layout === 'list' ? 'flex gap-4 sm:gap-6' : ''} ${layout === 'compact' ? 'flex gap-3' : ''}`}>
  <a href={`/blog/${slug}`} class={`block ${
    layout === 'list' ? 'w-1/3 sm:w-1/4 flex-shrink-0' : ''
  } ${layout === 'compact' ? 'w-20 sm:w-24 flex-shrink-0' : ''}`}>
    {coverImage && (
      <div class={`overflow-hidden bg-gray-100 ${
        layout === 'hero' ? 'aspect-video rounded-t-lg sm:rounded-lg' : 
        layout === 'subhero' ? 'aspect-video rounded-lg mb-3' : 
        layout === 'list' ? 'aspect-[4/3] rounded-lg' : 
        layout === 'compact' ? 'aspect-square rounded-md' : 'aspect-video rounded-lg mb-3'
      }`}>
        <img
          src={coverImage}
          alt={title}
          width="800"
          height={layout === 'compact' ? '800' : '450'}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading={isFirstCard ? 'eager' : 'lazy'}
          fetchpriority={isFirstCard ? 'high' : 'auto'}
          decoding={isFirstCard ? 'sync' : 'async'}
        />
      </div>
    )}
  </a>
  <div class={`flex flex-col justify-center ${
    layout === 'hero' ? 'mt-4 sm:px-2' : 
    layout === 'list' ? 'flex-1 py-1' : 
    layout === 'compact' ? 'flex-1' : ''
  }`}>
    {category && layout !== 'compact' && layout !== 'subhero' && (
      <span class="inline-block text-xs font-extrabold text-red-600 uppercase mb-2 tracking-wider">
        {category}
      </span>
    )}
    <a href={`/blog/${slug}`} class="block group">
      <h3 class={`font-bold text-gray-900 group-hover:text-red-600 transition-colors leading-tight ${
        layout === 'hero' ? 'text-2xl sm:text-3xl lg:text-4xl' : 
        layout === 'subhero' ? 'text-lg sm:text-xl' : 
        layout === 'list' ? 'text-lg sm:text-xl' : 
        layout === 'compact' ? 'text-sm' : 'text-lg'
      }`}>
        {title}
      </h3>
    </a>
    {(layout === 'hero' || layout === 'list' || layout === 'grid') && (
      <p class={`text-gray-600 leading-relaxed mt-2 ${
        layout === 'hero' ? 'text-base line-clamp-3' : 'text-sm line-clamp-2'
      }`}>
        {excerpt}
      </p>
    )}
    <div class={`flex items-center text-xs text-gray-500 font-medium ${layout === 'compact' ? 'mt-1' : 'mt-3'}`}>
      {(layout === 'compact' || layout === 'subhero') && category && (
        <span class="text-red-600 font-bold uppercase mr-2">{category}</span>
      )}
      <time datetime={publishDate}>
        {formattedDate}
      </time>
    </div>
  </div>
</article>
